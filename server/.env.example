# Copy to .env and fill in for your environment. Every value below has a safe
# local-dev default in app/config.py except where noted — nothing here is
# required just to run `uvicorn app.main:app --reload` against SQLite.

# --- Database ---------------------------------------------------------------
# Local dev default (set in code): sqlite:///./dev.db — leave commented out
# below to use it. Production (Supabase Postgres, from Project Settings ->
# Database -> Connection string):
# DATABASE_URL=postgresql+psycopg2://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

# --- Auth --------------------------------------------------------------------
# REQUIRED in any environment other than local dev — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# --- Supabase Storage (for diagnose image uploads) ---------------------------
# Leave unset in local dev — /diagnose falls back to saving images under
# ./local_uploads and still works end to end.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=scan-images

# --- Mandi price ingestion (data.gov.in OGD API) -----------------------------
# Leave unset to skip ingestion — seed sample data instead (see app/seed).
OGD_API_KEY=
OGD_RESOURCE_ID=

# Shared secret required in the header `X-Internal-Token` to call
# POST /internal/ingest-prices — this endpoint is not for client use.
INTERNAL_API_TOKEN=dev-only-internal-token

# --- ML inference --------------------------------------------------------
# Path to a trained .tflite model. Leave unset to use the deterministic stub
# inference (see app/services/inference.py) until a model is trained.
TFLITE_MODEL_PATH=

# --- Misc ---------------------------------------------------------------
ENV=development
# Comma-separated origins allowed to call this API from a browser (the Next.js PWA).
CORS_ORIGINS=http://localhost:3000

# --- Voice transcription (POST /voice/transcribe, used by the Expo app's Voice
# Assistant screen) -------------------------------------------------------
# Leave unset to have /voice/transcribe respond 503 — there is no on-device
# fallback (Expo Go can't load native STT, and the Web Speech API is
# browser-only). Get a key at https://aistudio.google.com/apikey
#
# Stick to a *-flash model unless billing is enabled on the Google Cloud
# project behind this key: every gemini-*-pro model (including the
# gemini-pro-latest / gemini-3.1-pro-preview alias) returned 429
# RESOURCE_EXHAUSTED with an explicit free-tier limit of 0 when tested here —
# that's a hard block, not a transient rate limit, so switching to Pro without
# billing enabled will make every request fail.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
